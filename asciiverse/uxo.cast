[0.016, "o", "\u001b[9;10H\u001b[38;2;255;176;0;48;2;8;8;12m╭──\u001b[9;89H─╮\u001b[10;10H│\u001b[39;48;2;8;8;12m  \u001b[10;42H\u001b[38;2;120;120;130;48;2;8;8;12mTHE CLOCK \u001b[10;53H03:48\u001b[39;48;2;8;8;12m \u001b[10;89H \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[11;10H│\u001b[39;48;2;8;8;12m  \u001b[11;40H\u001b[1m\u001b[38;2;255;176;0;48;2;8;8;12m2-1 \u001b[11;45HTHE SECOND HAND\u001b[22m\u001b[39;48;2;8;8;12m \u001b[11;89H \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[12;10H│\u001b[39;48;2;8;8;12m  \u001b[12;89H \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[13;10H│\u001b[39;48;2;8;8;12m  \u001b[38;2;230;230;236;48;2;8;8;12mThe hatch out of the Screensaver drops Dot and Caret into the Clock, the\u001b[39;48;2;8;8;12m  \u001b[13;89H \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[14;10H│\u001b[39;48;2;8;8;12m  \u001b[38;2;230;230;236;48;2;8;8;12mprogram that keeps the machine's time. Everything in her\u001b[14;70H ticks.\u001b[39;48;2;8;8;12m  \u001b[14;89H \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[15;10H│\u001b[39;48;2;8;8;12m  \u001b[38;2;230;230;236;48;2;8;8;12mpurged has had a new idea: why wait for four o'clock? It is winding\u001b[15;89H\u001b[39;48;2;8;8;12m \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[16;10H│"]
[0.000, "o", "\u001b[39;48;2;8;8;12m  \u001b[38;2;230;230;236;48;2;8;8;12mthe clock on, and every minute it gains is a minute less for Dot and Caret.\u001b[16;89H\u001b[39;48;2;8;8;12m \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[17;10H│\u001b[39;48;2;8;8;12m  \u001b[38;2;230;230;236;48;2;8;8;12mIts ticks are wind-up mites that follow the walls round and round,\u001b[17;89H\u001b[39;48;2;8;8;12m \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[18;10H│\u001b[39;48;2;8;8;12m  \u001b[38;2;230;230;236;48;2;8;8;12malways keeping one on their right. Clear them out.\u001b[18;89H\u001b[39;48;2;8;8;12m \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[19;10H│\u001b[39;48;2;8;8;12m  \u001b[19;89H \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[20;10H│\u001b[39;48;2;8;8;12m  \u001b[20;27H\u001b[38;2;255;220;90;48;2;8;8;12mGoal: beat every bad\u001b[20;48Hie, then reach the hatch.\u001b[39;48;2;8;8;12m \u001b[20;89H \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[21;10H│\u001b[39;48;2;8;8;12m  \u001b[21;44H\u001b[38;2;120;120;130;48;2;8;8;12mbomb to begin\u001b[39;48;2;8;8;12m \u001b[21;89H \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[22;10H╰──\u001b[22;89H─╯\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l"]
