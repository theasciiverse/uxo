[0.016068, "o", "\u001b[9;15H\u001b[38;2;255;176;0;48;2;8;8;12m╭──────────\u001b[9;76H─────────╮\u001b[10;15H│\u001b[39;48;2;8;8;12m          \u001b[10;45H\u001b[38;2;120;120;130;48;2;8;8;12mTHE ORCHARD\u001b[39;48;2;8;8;12m \u001b[10;76H         \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[11;15H│\u001b[39;48;2;8;8;12m          \u001b[11;41H\u001b[1m\u001b[38;2;255;176;0;48;2;8;8;12m1-1 \u001b[11;46HWINDFAL\u001b[11;54H LANE\u001b[22m\u001b[39;48;2;8;8;12m \u001b[11;76H         \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[12;15H│\u001b[39;48;2;8;8;12m          \u001b[12;76H         \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[13;15H│\u001b[39;48;2;8;8;12m  \u001b[38;2;230;230;236;48;2;8;8;12mThe night before the Festival of Lights, the workshop went quiet.\u001b[39;48;2;8;8;12m  \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[14;15H│\u001b[39;48;2;8;8;12m  \u001b[38;2;230;230;236;48;2;8;8;12mEvery firework you made for it is gone, scattered over the hills,\u001b[39;48;2;8;8;12m  \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[15;15H│\u001b[39;48;2;8;8;12m  \u001b[38;2;230;230;236;48;2;8;8;12mcome down as duds all through the Orchard. And the Orchard has\u001b[39;48;2;8;8;12"]
[6.4e-05, "o", "m     \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[16;15H│\u001b[39;48;2;8;8;12m  \u001b[38;2;230;230;236;48;2;8;8;12mgone strange. Bring the festival back, one stage at a time.\u001b[39;48;2;8;8;12m        \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[17;15H│\u001b[39;48;2;8;8;12m  \u001b[38;2;230;230;236;48;2;8;8;12mHere: clear the lane of grubs, and the hatch opens.\u001b[17;76H\u001b[39;48;2;8;8;12m         \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[18;15H│\u001b[39;48;2;8;8;12m          \u001b[18;76H         \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[19;15H│\u001b[39;48;2;8;8;12m          \u001b[19;27H\u001b[38;2;255;220;90;48;2;8;8;12mGoal: beat every bad\u001b[19;48Hie, then reach the hatch.\u001b[39;48;2;8;8;12m \u001b[19;76H         \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[20;15H│\u001b[39;48;2;8;8;12m          \u001b[20;44H\u001b[38;2;120;120;130;48;2;8;8;12mbomb to begin\u001b[39;48;2;8;8;12m \u001b[20;76H         \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[21;15H╰──────────\u001b[21;76H─────────╯\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l"]
